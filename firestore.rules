rules_version = '2';

// ============================================================
// PRATA AQUA — Firestore Security Rules
// Paste this into Firebase Console → Firestore Database → Rules
// ============================================================

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    // User profiles
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn();
      allow delete: if isSignedIn();
    }

    // Special admin marker document
    match /users/admin_exists {
      allow read, create, update, delete: if isSignedIn();
    }

    // Registered bottle / customisation types
    match /bottles/{bottleId} {
      allow read, create, update, delete: if isSignedIn();
    }

    // Registered resorts / companies
    match /resorts/{resortId} {
      allow read, create, update, delete: if isSignedIn();
    }

    // Customisation sales entry records
    match /entries/{entryId} {
      allow read, create, update, delete: if isSignedIn();
    }

    // Batch stock records (product, size, batchNo, qty, date)
    match /stockBatches/{batchId} {
      allow read, create, update, delete: if isSignedIn();
    }

    // Stock summary doc per bottle
    match /stock/{bottleId} {
      allow read, create, update, delete: if isSignedIn();
    }

    // Stock transactions log
    match /stockTransactions/{txId} {
      allow read, create, update, delete: if isSignedIn();
    }
  }
}
